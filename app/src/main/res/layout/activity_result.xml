<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@color/bg_dark" android:padding="40dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="80sp" android:layout_marginBottom="16dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOU WIN!" android:textColor="@color/accent_green" android:textSize="48sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.2"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maze completed" android:textColor="@color/text_dim" android:textSize="16sp" android:fontFamily="monospace" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>
    <View android:layout_width="80dp" android:layout_height="2dp" android:background="@color/accent_green" android:layout_marginBottom="32dp"/>
    <TextView android:id="@+id/tvStepCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Steps taken: 0" android:textColor="@color/text_bright" android:textSize="18sp" android:fontFamily="monospace" android:layout_marginBottom="48dp"/>
    <Button android:id="@+id/btnRestart" android:layout_width="220dp" android:layout_height="56dp" android:text="↺ PLAY AGAIN" android:textColor="@color/bg_dark" android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" android:backgroundTint="@color/accent_green" android:stateListAnimator="@null" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnMenu" android:layout_width="220dp" android:layout_height="56dp" android:text="⌂ MAIN MENU" android:textColor="@color/accent_green" android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" android:backgroundTint="@color/bg_card" android:stateListAnimator="@null"/>
</LinearLayout>
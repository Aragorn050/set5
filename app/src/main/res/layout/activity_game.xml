<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
    <!--  TOP INFO BAR  -->
    <LinearLayout android:id="@+id/infoBar" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/bg_card" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:gravity="center_vertical" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvRoomCoords" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Room [0, 0]" android:textColor="@color/accent_green" android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tvMaskDebug" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="mask: 0" android:textColor="@color/text_dim" android:textSize="12sp" android:fontFamily="monospace"/>
    </LinearLayout>
    <!--  UP BUTTON  -->
    <Button android:id="@+id/btnUp" android:layout_width="100dp" android:layout_height="64dp" android:text="▲ UP" android:textSize="14sp" android:fontFamily="monospace" android:stateListAnimator="@null" app:layout_constraintTop_toBottomOf="@id/infoBar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="24dp"/>
    <!--  ROOM CENTER DISPLAY  -->
    <LinearLayout android:id="@+id/roomCenter" android:layout_width="0dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/room_border" android:layout_marginHorizontal="120dp" app:layout_constraintTop_toBottomOf="@id/btnUp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/btnDown" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚪" android:textSize="40sp"/>
        <TextView android:id="@+id/tvRoomLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROOM" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:letterSpacing="0.3" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvRoomNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0, 0" android:textColor="@color/text_bright" android:textSize="22sp" android:textStyle="bold" android:fontFamily="monospace"/>
    </LinearLayout>
    <!--  LEFT BUTTON  -->
    <Button android:id="@+id/btnLeft" android:layout_width="100dp" android:layout_height="64dp" android:text="◀ LEFT" android:textSize="13sp" android:fontFamily="monospace" android:stateListAnimator="@null" app:layout_constraintTop_toTopOf="@id/roomCenter" app:layout_constraintBottom_toBottomOf="@id/roomCenter" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="8dp"/>
    <!--  RIGHT BUTTON  -->
    <Button android:id="@+id/btnRight" android:layout_width="100dp" android:layout_height="64dp" android:text="RIGHT ▶" android:textSize="13sp" android:fontFamily="monospace" android:stateListAnimator="@null" app:layout_constraintTop_toTopOf="@id/roomCenter" app:layout_constraintBottom_toBottomOf="@id/roomCenter" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="8dp"/>
    <!--  DOWN BUTTON  -->
    <Button android:id="@+id/btnDown" android:layout_width="100dp" android:layout_height="64dp" android:text="▼ DOWN" android:textSize="14sp" android:fontFamily="monospace" android:stateListAnimator="@null" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="40dp"/>
    <!--  DOOR STATUS ROW  -->
    <LinearLayout android:id="@+id/doorStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" app:layout_constraintTop_toBottomOf="@id/roomCenter" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="12dp">
        <TextView android:id="@+id/tvDoorStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doors: —" android:textColor="@color/text_dim" android:textSize="12sp" android:fontFamily="monospace"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>